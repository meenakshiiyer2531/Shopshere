# Copy this file to `.env` and fill in your own credentials.

# --- Database (Neon Postgres) ---
# Pooled connection string from the Neon dashboard (Connection Details).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Payments (Razorpay) ---
# Get test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# --- Server ---
# 4100 avoids a local port-policing daemon that kills binders on 4000.
PORT=4100

# --- Admin panel login (used to sign in to the /admin page) ---
ADMIN_USER=admin
ADMIN_PASSWORD=1234

# --- SAP AI Core (ShopSphere AI layer) ---
# Credentials from your SAP AI Core service key (Generative AI Hub). When these
# are absent the AI layer automatically uses its deterministic fallback engine,
# so the app still works with zero configuration.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com
AICORE_BASE_URL=https://api.ai.<region>.aws.ml.hana.ondemand.com
AICORE_RESOURCE_GROUP=default
# Optional overrides:
# AICORE_ORCHESTRATION_ID=   # a RUNNING orchestration deployment id
# AICORE_MODEL=gpt-4o-mini   # any model name available in your Gen AI Hub
# AICORE_TIMEOUT_MS=9000
